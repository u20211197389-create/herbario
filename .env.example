# Copie este archivo como .env y complete los datos. El archivo .env no se sube a GitHub.
# Ejemplo con Gmail: cuenta con verificación en dos pasos y una "contraseña de aplicación".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo-del-herbario@gmail.com
SMTP_PASS=contraseña-de-aplicacion
SMTP_FROM="Herbario SURCO <correo-del-herbario@gmail.com>"
# Dirección pública del sitio con el servidor, usada en el enlace del correo.
PUBLIC_URL=http://127.0.0.1:5173
